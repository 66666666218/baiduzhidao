{
  "name": "zhidao-answer-studio",
  "productName": "百度知道答题助手 v2",
  "version": "2.0.11",
  "description": "百度知道活动页答题助手（v2 重构版）：题目爬取、随机抽题、AI 生成回答、自动提交",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.test.js\"",
    "mock": "node mock-site/run.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "selftest": "node scripts/selftest-cli.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.48.0",
    "undici": "^8.11.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "com.zhidao.answer.studio",
    "productName": "百度知道答题助手v2",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "mock-site/**/*",
      "package.json"
    ],
    "artifactName": "zhidao-answer-studio-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "66666666218",
      "repo": "baiduzhidao"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
